{
  "name": "@figma-flow-annotator/flow-annotator",
  "version": "1.0.0",
  "private": true,
  "description": "Figma Flow Annotator plugin",
  "main": "code.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/plugin/code.ts --bundle --target=es2017 --outfile=code.js && pnpm run check:figma-syntax",
    "check:figma-syntax": "node --check code.js",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "node --test tests/annotations/*.test.mjs tests/connectors/*.test.mjs",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:annotate": "playwright test -c playwright.config.ts annotations/visual.spec.ts",
    "test:visual:connect": "playwright test -c playwright.config.ts connectors/visual.spec.ts",
    "test:visual:panel": "playwright test -c playwright.config.ts panel/ui.spec.ts",
    "verify": "pnpm run test && pnpm run test:visual && pnpm run lint && pnpm run build",
    "watch": "esbuild src/plugin/code.ts --bundle --target=es2017 --outfile=code.js --watch"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@figma-flow-annotator/core": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@playwright/test": "^1.59.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
